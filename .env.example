# =====================================================================
# Modele de configuration — copier en .env et renseigner les valeurs
# Tout ce qui commence par VITE_ est expose au navigateur.
# =====================================================================

# --- Supabase (obligatoire) ---
SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PROJECT_ID=""
SUPABASE_URL="https://VOTRE-REF.supabase.co"
VITE_SUPABASE_URL="https://VOTRE-REF.supabase.co"

# Cle publique (navigateur)
SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Cle secrete (serveur uniquement — ne jamais exposer)
SUPABASE_SERVICE_ROLE_KEY=""

# --- Paddle (paiements, appel direct) ---
PADDLE_SANDBOX_API_KEY=""
PADDLE_LIVE_API_KEY=""
PAYMENTS_SANDBOX_WEBHOOK_SECRET=""
PAYMENTS_LIVE_WEBHOOK_SECRET=""
VITE_PAYMENTS_CLIENT_TOKEN=""

# --- Pont Hermes (interface <-> agents) ---
HERMES_BRIDGE_TOKEN=""
